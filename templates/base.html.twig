<!DOCTYPE html>
<html lang="{{app.request.locale|default('es')}}">
    <head data-no-traslate="1">
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Teaching Explorer{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}TeachingExplorer, plataforma educativa moderna para estudiantes y profesores.{% endblock %}">
        <meta name="theme-color" content="#0f172a">
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}?v=2">
        <script>
            (function(){
                try{
                    //El tema de la pagina se guarda con LocalStorage, que por defecto sera claro
                    const tema = localStorage.getItem('te_modo') || 'claro';
                    const oscuro = tema === 'oscuro';
                    //Variables para el fondo de la pagina dependiendo del tema
                    const fondo = oscuro ? '#0f172a' : '#f5f7fb';

                    //Cambia el fondo de la pagina por la variable de fondo
                    document.documentElement.style.backgroundColor = fondo;
                    //Añade o quita la clase tema-oscuro
                    document.documentElement.classList.toggle('tema-oscuro', oscuro);
                }catch(e){

                }
            })();
        </script>
        <style>
            html, body {
                margin: 0;
                min-height: 100%;
            }
            {#Oculta el body hasta que cargue la pagina#}
            body {
                visibility: hidden;
            }
            {#Muestra el body cuando carga la pagina#}
            body.app-lista {
                visibility: visible;
            }

            .pantalla-carga {
                position: fixed;
                inset: 0;
                z-index: 9999;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #f5f7fb;
                transition: opacity .2s ease, visibility .2s ease;
            }

            {#Estilo para el modo oscuro#}
            html.tema-oscuro .pantalla-carga {
                background: #0f172a;
            }

            {#Oculta la pantalla de carga#}
            .pantalla-carga.oculta {
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
            }

            .pantalla-carga__punto {
                width: 14px;
                height: 14px;
                border-radius: 50%;
                background: #3b82f6;
                box-shadow:
                    -24px 0 0 rgba(59, 130, 246, 0.35),
                    24px 0 0 rgba(59, 130, 246, 0.35);
            }
        </style>

       {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('build/app.css') }}">
            <script type="module" src="{{ asset('build/app.js') }}"></script>
        {% endblock %}

    </head>
    <body>
        {#Enlace al contenido principal#}
        <a href="#contenido-principal" class="enlace-salto">Saltar al contenido principal</a>

        {#Pantalla de carga#}
        <div id="pantalla-carga" class="pantalla-carga" aria-hidden="true">
            <div class="pantalla-carga__punto"></div>
        </div>

        {#Menu de navegacion#}
        <div data-no-translate="1">
            {% include 'componentes/navegacion.html.twig' %}
        </div>

        {#Contenido principal para cada pagina#}
        <main id="contenido-principal" class="layout-principal" data-dynamic-translate="1">
            {% block body %}{% endblock %}
        </main>

        {#Pie de pagina#}
        <div data-no-translate="1">
            {% include 'componentes/pie.html.twig' %}
        </div>

        <script>
            //Evento cuando termina de cargar la pagina
            window.addEventListener('load', function () {
                //Si el tema es oscuro lo se al body
                if (document.documentElement.classList.contains('tema-oscuro')) {
                    document.body.classList.add('tema-oscuro');
                }
                //Marca la app como lista para mostrar el contenido
                document.body.classList.add('app-lista');

                //Oculta la pantalla de carga
                const loader = document.getElementById('pantalla-carga');
                if (loader) {
                    loader.classList.add('oculta');
                }
            });

        </script>
    </body>
</html>
