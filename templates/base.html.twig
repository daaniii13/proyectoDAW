<!DOCTYPE html>
<html lang="{{ app.request.locale|default('es') }}">
    <head data-no-translate="1">
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>{% block title %}TeachingExplorer{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}TeachingExplorer, plataforma educativa moderna para estudiantes y profesores.{% endblock %}">
        <meta name="theme-color" content="#0f172a">
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}?v=2">

        <script>
            (function () {
                try {
                    const tema = localStorage.getItem('te_modo') || 'claro';
                    const oscuro = tema === 'oscuro';
                    const fondo = oscuro ? '#0f172a' : '#f5f7fb';
                    const esquema = oscuro ? 'dark' : 'light';

                    document.documentElement.style.backgroundColor = fondo;
                    document.documentElement.style.colorScheme = esquema;
                    document.documentElement.classList.toggle('tema-oscuro', oscuro);
                    document.documentElement.setAttribute('data-bs-theme', esquema);
                } catch (e) {}
            })();
        </script>

        <style>
            html, body {
                margin: 0;
                min-height: 100%;
            }

            html {
                background-color: #f5f7fb;
            }

            html.tema-oscuro {
                background-color: #0f172a;
            }

            body {
                opacity: 0;
                background-color: transparent;
                transition: opacity .18s ease;
            }

            body.app-lista {
                opacity: 1;
            }

            .pantalla-carga {
                position: fixed;
                inset: 0;
                z-index: 9999;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #f5f7fb;
                transition: opacity .2s ease, visibility .2s ease;
            }

            html.tema-oscuro .pantalla-carga {
                background: #0f172a;
            }

            .pantalla-carga.oculta {
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
            }

            .pantalla-carga__punto {
                width: 14px;
                height: 14px;
                border-radius: 50%;
                background: #3b82f6;
                box-shadow:
                    -24px 0 0 rgba(59, 130, 246, 0.35),
                    24px 0 0 rgba(59, 130, 246, 0.35);
            }
        </style>

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('build/app.css') }}">
            <script type="module" src="{{ asset('build/app.js') }}"></script>
        {% endblock %}
    </head>

    <body>
        <script>
            (function () {
                try {
                    const tema = localStorage.getItem('te_modo') || 'claro';
                    const oscuro = tema === 'oscuro';
                    const esquema = oscuro ? 'dark' : 'light';

                    document.body.classList.toggle('tema-oscuro', oscuro);
                    document.body.setAttribute('data-bs-theme', esquema);
                } catch (e) {}
            })();
        </script>

        <a href="#contenido-principal" class="enlace-salto">Saltar al contenido principal</a>

        <div id="pantalla-carga" class="pantalla-carga" aria-hidden="true">
            <div class="pantalla-carga__punto"></div>
        </div>

        <div data-no-translate="1">
            {% include 'componentes/navegacion.html.twig' %}
        </div>

        <main id="contenido-principal" class="layout-principal" data-dynamic-translate="1">
            {% block body %}{% endblock %}
        </main>

        <div data-no-translate="1">
            {% include 'componentes/pie.html.twig' %}
        </div>

        {% block javascripts %}{% endblock %}

        <script>
            (function () {
                function aplicarTemaEnBody() {
                    try {
                        const oscuro = document.documentElement.classList.contains('tema-oscuro');
                        const esquema = oscuro ? 'dark' : 'light';

                        document.body.classList.toggle('tema-oscuro', oscuro);
                        document.body.setAttribute('data-bs-theme', esquema);
                    } catch (e) {}
                }

                function mostrarAplicacion() {
                    aplicarTemaEnBody();
                    document.body.classList.add('app-lista');

                    const loader = document.getElementById('pantalla-carga');
                    if (loader) {
                        loader.classList.add('oculta');
                    }
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', mostrarAplicacion, { once: true });
                } else {
                    mostrarAplicacion();
                }

                window.addEventListener('pageshow', mostrarAplicacion);
                window.addEventListener('load', mostrarAplicacion);
            })();

            document.addEventListener('click', function (event) {
                const boton = event.target.closest('[data-toggle-password]');
                if (!boton) {
                    return;
                }

                const inputId = boton.getAttribute('data-toggle-password');
                const input = document.getElementById(inputId);

                if (!input) {
                    return;
                }

                const mostrando = input.getAttribute('type') === 'text';
                input.setAttribute('type', mostrando ? 'password' : 'text');

                const iconoVer = boton.querySelector('.campo-password__icono--ver');
                const iconoOcultar = boton.querySelector('.campo-password__icono--ocultar');

                if (iconoVer && iconoOcultar) {
                    iconoVer.hidden = !mostrando;
                    iconoOcultar.hidden = mostrando;
                }
            });
        </script>
    </body>
</html>