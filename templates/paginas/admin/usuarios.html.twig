{% extends 'base.html.twig' %}

{% block title %}Usuarios | Admin | TeachingExplorer{% endblock %}

{% block body %}
{#Pagina de gestion de usuarios registrados#}
<section class="seccion-profesor">
    <div class="container">
        <div class="profesor__cabecera">
            <div>
                <span class="profesor__etiqueta">Administración</span>
                <h1>Usuarios registrados</h1>
                <p class="profesor__texto">Modifica nombre, correo, rol principal, estado y elimina usuarios si es necesario.</p>
            </div>
        </div>

        {#Bucles de las notificaciones de exito o error#}
        {% for mensaje in app.flashes('success') %}
            <div class="mensaje-ui mensaje-ui--exito profesor__nota">
                <span>{{ mensaje }}</span>
            </div>
        {% endfor %}

        {% for mensaje in app.flashes('error') %}
            <div class="mensaje-ui mensaje-ui--error profesor__nota">
                <span>{{ mensaje }}</span>
            </div>
        {% endfor %}

        {#Pantalla si no hay usuarios#}
        {% if usuarios is empty %}
            <div class="estado-vacio">
                <div class="estado-vacio__icono">0</div>
                <h3 class="estado-vacio__titulo">No hay usuarios</h3>
                <p class="estado-vacio__texto">Todavía no hay cuentas registradas.</p>
            </div>
        {% else %}
            <div class="d-flex flex-column gap-4">
                {#Bucle de usuarios registrados y formularios de edición#}
                {% for usuario in usuarios %}
                    <article class="profesor__bloque">
                        
                        {#Formulario de edición e informacion del usuario#}
                        <form method="post" action="{{ path('app_admin_usuario_editar', {id: usuario.id}) }}" class="profesor__formulario">
                            <input type="hidden" name="_token" value="{{ csrf_token('editar_usuario_' ~ usuario.id) }}">
                            
                            <div class="curso-usuario__superior mb-4">
                                <div>
                                    <span class="badge text-bg-primary">#{{ usuario.id }}</span>
                                    <span class="curso-usuario__progreso ms-2">{{ usuario.activo ? 'Activo' : 'Inactivo' }}</span>
                                </div>
                                <small>Registro: {{ usuario.fechaRegistro|date('d/m/Y H:i') }}</small>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <label class="form-label">Nombre</label>
                                    <input type="text" name="nombre" class="form-control" value="{{ usuario.nombre }}" required>
                                </div>

                                <div class="col-12 col-md-4">
                                    <label class="form-label">Correo</label>
                                    <input type="email" name="email" class="form-control" value="{{ usuario.email }}" required>
                                </div>

                                <div class="col-12 col-md-4">
                                    <label class="form-label">Estado</label>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input" type="checkbox" name="activo" value="1" id="activo_{{ usuario.id }}" {{ usuario.activo ? 'checked' : '' }}>
                                        <label class="form-check-label" for="activo_{{ usuario.id }}">Cuenta activa</label>
                                    </div>
                                </div>

                                {#Rol del usuario#}
                                <div class="col-12">
                                    <label class="form-label d-block">Rol principal</label>

                                    {% set rolActual = 'ROLE_ESTUDIANTE' %}
                                    {% if 'ROLE_ADMIN' in usuario.roles %}
                                        {% set rolActual = 'ROLE_ADMIN' %}
                                    {% elseif 'ROLE_PROFESOR' in usuario.roles %}
                                        {% set rolActual = 'ROLE_PROFESOR' %}
                                    {% endif %}

                                    <div class="d-flex flex-wrap gap-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="rol" value="ROLE_ESTUDIANTE" id="rol_estudiante_{{ usuario.id }}" {{ rolActual == 'ROLE_ESTUDIANTE' ? 'checked' : '' }}>
                                            <label class="form-check-label" for="rol_estudiante_{{ usuario.id }}">Estudiante</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="rol" value="ROLE_PROFESOR" id="rol_profesor_{{ usuario.id }}" {{ rolActual == 'ROLE_PROFESOR' ? 'checked' : '' }}>
                                            <label class="form-check-label" for="rol_profesor_{{ usuario.id }}">Profesor</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="rol" value="ROLE_ADMIN" id="rol_admin_{{ usuario.id }}" {{ rolActual == 'ROLE_ADMIN' ? 'checked' : '' }}>
                                            <label class="form-check-label" for="rol_admin_{{ usuario.id }}">Admin</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="curso-usuario__acciones mt-4">
                                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                            </div>
                        </form>

                        {#Formulario de eliminacion#}
                        <form method="post" action="{{ path('app_admin_usuario_eliminar', {id: usuario.id}) }}" class="mt-3" onsubmit="return confirm('¿Seguro que quieres eliminar este usuario?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('eliminar_usuario_' ~ usuario.id) }}">
                            <button type="submit" class="btn btn-outline-danger">Eliminar usuario</button>
                        </form>

                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}