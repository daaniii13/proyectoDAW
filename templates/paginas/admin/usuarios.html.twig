{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.usuarios.meta_titulo'|trans }}{% endblock %}

{% block body %}
<section class="seccion-profesor">
    <div class="container">
        <div class="profesor__cabecera">
            <div>
                <span class="profesor__etiqueta">{{ 'admin.usuarios.etiqueta'|trans }}</span>
                <h1>{{ 'admin.usuarios.titulo'|trans }}</h1>
                <p class="profesor__texto">
                    {{ 'admin.usuarios.descripcion'|trans }}
                </p>
            </div>
        </div>

        {% for mensaje in app.flashes('success') %}
            <div class="mensaje-ui mensaje-ui--exito profesor__nota">
                <span>{{ mensaje|trans }}</span>
            </div>
        {% endfor %}

        {% for mensaje in app.flashes('error') %}
            <div class="mensaje-ui mensaje-ui--error profesor__nota">
                <span>{{ mensaje|trans }}</span>
            </div>
        {% endfor %}

        {% if usuarios is empty %}
            <div class="estado-vacio">
                <div class="estado-vacio__icono">0</div>
                <h3 class="estado-vacio__titulo">{{ 'admin.usuarios.vacio_titulo'|trans }}</h3>
                <p class="estado-vacio__texto">{{ 'admin.usuarios.vacio_texto'|trans }}</p>
            </div>
        {% else %}
            <div class="d-flex flex-column gap-4">
                {% for usuario in usuarios %}
                    <article class="profesor__bloque">
                        <form method="post" action="{{ path('app_admin_usuario_editar', {id: usuario.id}) }}" class="profesor__formulario">
                            <input type="hidden" name="_token" value="{{ csrf_token('editar_usuario_' ~ usuario.id) }}">

                            <div class="curso-usuario__superior mb-4">
                                <div>
                                    <span class="badge text-bg-primary">#{{ usuario.id }}</span>
                                    <span class="curso-usuario__progreso ms-2">
                                        {{ usuario.activo ? 'admin.usuarios.activo'|trans : 'admin.usuarios.inactivo'|trans }}
                                    </span>
                                </div>

                                <small>{{ 'admin.usuarios.registro'|trans }}: {{ usuario.fechaRegistro|date('d/m/Y H:i') }}</small>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <label class="form-label">{{ 'admin.usuarios.nombre'|trans }}</label>
                                    <input type="text" name="nombre" class="form-control" value="{{ usuario.nombre }}" required>
                                </div>

                                <div class="col-12 col-md-4">
                                    <label class="form-label">{{ 'admin.usuarios.correo'|trans }}</label>
                                    <input type="email" name="email" class="form-control" value="{{ usuario.email }}" required>
                                </div>

                                <div class="col-12 col-md-4">
                                    <label class="form-label">{{ 'admin.usuarios.estado'|trans }}</label>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input" type="checkbox" name="activo" value="1" id="activo_{{ usuario.id }}" {{ usuario.activo ? 'checked' : '' }}>
                                        <label class="form-check-label" for="activo_{{ usuario.id }}">
                                            {{ 'admin.usuarios.cuenta_activa'|trans }}
                                        </label>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label class="form-label d-block">{{ 'admin.usuarios.rol_principal'|trans }}</label>

                                    {% set rolActual = 'ROLE_ESTUDIANTE' %}
                                    {% if 'ROLE_ADMIN' in usuario.roles %}
                                        {% set rolActual = 'ROLE_ADMIN' %}
                                    {% elseif 'ROLE_PROFESOR' in usuario.roles %}
                                        {% set rolActual = 'ROLE_PROFESOR' %}
                                    {% endif %}

                                    <div class="d-flex flex-wrap gap-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="rol" value="ROLE_ESTUDIANTE" id="rol_estudiante_{{ usuario.id }}" {{ rolActual == 'ROLE_ESTUDIANTE' ? 'checked' : '' }}>
                                            <label class="form-check-label" for="rol_estudiante_{{ usuario.id }}">
                                                {{ 'admin.usuarios.rol_estudiante'|trans }}
                                            </label>
                                        </div>

                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="rol" value="ROLE_PROFESOR" id="rol_profesor_{{ usuario.id }}" {{ rolActual == 'ROLE_PROFESOR' ? 'checked' : '' }}>
                                            <label class="form-check-label" for="rol_profesor_{{ usuario.id }}">
                                                {{ 'admin.usuarios.rol_profesor'|trans }}
                                            </label>
                                        </div>

                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="rol" value="ROLE_ADMIN" id="rol_admin_{{ usuario.id }}" {{ rolActual == 'ROLE_ADMIN' ? 'checked' : '' }}>
                                            <label class="form-check-label" for="rol_admin_{{ usuario.id }}">
                                                {{ 'admin.usuarios.rol_admin'|trans }}
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="curso-usuario__acciones mt-4">
                                <button type="submit" class="btn btn-primary">
                                    {{ 'admin.usuarios.guardar'|trans }}
                                </button>
                            </div>
                        </form>

                        <form method="post" action="{{ path('app_admin_usuario_eliminar', {id: usuario.id}) }}" class="mt-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('eliminar_usuario_' ~ usuario.id) }}">
                            <button type="submit" class="btn btn-outline-danger">
                                {{ 'admin.usuarios.eliminar'|trans }}
                            </button>
                        </form>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}