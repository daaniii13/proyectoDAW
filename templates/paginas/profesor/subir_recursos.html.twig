{% extends 'base.html.twig' %}

{% block title %}Panel del profesor | TeachingExplorer{% endblock %}

{% block body %}
<div data-dynamic-translate="1">
    {% set cuentaBancariaDocente = 'ES12 3456 7890 1234 5678 9012' %}

    <section class="seccion-profesor">
        <div class="container">
            {% include 'paginas/profesor/fragmentos/_panel_cabecera_y_mensajes.html.twig' with {
                suscripcionProfesor: suscripcionProfesor,
                cursosProfesor: cursosProfesor,
                errorCurso: errorCurso
            } %}

            {% if modoSolicitudProfesor %}
                {% include 'paginas/profesor/fragmentos/_panel_solicitud_docente.html.twig' with {
                    suscripcionProfesor: suscripcionProfesor,
                    cuentaBancariaDocente: cuentaBancariaDocente
                } %}
            {% else %}
                {% include 'paginas/profesor/fragmentos/_panel_suscripcion_y_cursos.html.twig' with {
                    suscripcionProfesor: suscripcionProfesor,
                    mensajeSuscripcion: mensajeSuscripcion,
                    cuentaBancariaDocente: cuentaBancariaDocente,
                    solicitudesPendientes: solicitudesPendientes,
                    puedeCrearCursos: puedeCrearCursos,
                    datosCurso: datosCurso,
                    cursosProfesor: cursosProfesor,
                    alumnosPorCurso: alumnosPorCurso
                } %}
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}