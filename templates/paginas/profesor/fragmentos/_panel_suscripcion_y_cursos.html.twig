<div class="row g-4 mb-4">
    {% if suscripcionProfesor %}
        <div class="col-12 col-lg-6">
            <section class="profesor__bloque h-100">
                <h2>Plan actual</h2>

                <div class="profesor__resumen-plan">
                    <div class="profesor__resumen-plan-superior">
                        <span class="badge text-bg-primary">Plan {{ suscripcionProfesor.plan|capitalize }}</span>
                        <span class="profesor__resumen-plan-estado">
                            Estado: {{ suscripcionProfesor.estado|capitalize }}
                        </span>
                    </div>

                    <div class="profesor__resumen-plan-meta">
                        <span>Límite de cursos: {{ suscripcionProfesor.limiteCursos }}</span>

                        {% if suscripcionProfesor.fechaSolicitud %}
                            <span>Solicitud: {{ suscripcionProfesor.fechaSolicitud|date('d/m/Y H:i') }}</span>
                        {% endif %}

                        {% if suscripcionProfesor.planSolicitado %}
                            <span>Plan solicitado: {{ suscripcionProfesor.planSolicitado|capitalize }}</span>
                        {% endif %}
                    </div>

                    {% if mensajeSuscripcion %}
                        <p class="profesor__resumen-plan-texto">{{ mensajeSuscripcion }}</p>
                    {% endif %}
                </div>
            </section>
        </div>
    {% endif %}

    {% if suscripcionProfesor and suscripcionProfesor.estado == 'activa' and suscripcionProfesor.tipoSolicitud is null %}
        <div class="col-12 col-lg-6">
            <section class="profesor__bloque h-100">
                <h2>Cambiar o cancelar plan</h2>

                <div class="d-flex flex-column gap-4">
                    <form method="post" class="profesor__formulario">
                        <input type="hidden" name="formulario" value="solicitar_cambio_plan">
                        <input type="hidden" name="_token" value="{{ csrf_token('solicitar_cambio_plan') }}">

                        <div class="mb-3">
                            <label for="plan_cambio_docente" class="form-label">Nuevo plan</label>
                            <select id="plan_cambio_docente" name="plan" class="form-select" required>
                                <option value="basico" {{ suscripcionProfesor.plan == 'basico' ? 'selected' : '' }}>Básico · 1 curso</option>
                                <option value="pro" {{ suscripcionProfesor.plan == 'pro' ? 'selected' : '' }}>Pro · 5 cursos</option>
                                <option value="premium" {{ suscripcionProfesor.plan == 'premium' ? 'selected' : '' }}>Premium · ilimitados</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Cuenta bancaria para el pago</label>
                            <div class="form-control d-flex align-items-center">{{ cuentaBancariaDocente }}</div>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="confirmacion_pago_cambio_plan" name="confirmacion_pago" value="1" required>
                            <label class="form-check-label" for="confirmacion_pago_cambio_plan">
                                Confirmo que he realizado el pago del nuevo plan.
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Solicitar cambio de plan
                        </button>
                    </form>

                    <form method="post" class="profesor__formulario">
                        <input type="hidden" name="formulario" value="solicitar_cancelacion">
                        <input type="hidden" name="_token" value="{{ csrf_token('solicitar_cancelacion') }}">

                        <p class="mb-3">La cancelación también debe ser revisada por el administrador.</p>

                        <button type="submit" class="btn btn-outline-danger w-100">
                            Solicitar cancelación
                        </button>
                    </form>
                </div>
            </section>
        </div>
    {% endif %}
</div>

{% if solicitudesPendientes is not empty %}
    <section class="profesor__bloque mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="mb-1">Solicitudes pendientes de validación</h2>
                <p class="mb-0">Revisa pagos y activa el acceso de cada alumno.</p>
            </div>
            <span class="badge text-bg-warning">{{ solicitudesPendientes|length }} pendiente(s)</span>
        </div>

        <div class="mis-cursos__grid">
            {% for inscripcion in solicitudesPendientes %}
                <article class="curso-usuario">
                    <div class="curso-usuario__superior">
                        <span class="badge text-bg-warning">Pendiente</span>
                        <span class="curso-usuario__progreso">{{ inscripcion.curso.titulo }}</span>
                    </div>

                    <h3>{{ inscripcion.estudiante.nombre }}</h3>

                    <div class="curso-usuario__meta">
                        <span>Correo: {{ inscripcion.estudiante.email }}</span>
                        <span>Referencia: {{ inscripcion.referenciaPago ?: 'Sin referencia' }}</span>
                    </div>

                    <div class="curso-usuario__acciones">
                        <form method="post" action="{{ path('app_profesor_activar_inscripcion', {id: inscripcion.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('activar_inscripcion_' ~ inscripcion.id) }}">
                            <button type="submit" class="btn btn-primary">Activar acceso</button>
                        </form>

                        <form method="post" action="{{ path('app_profesor_rechazar_inscripcion', {id: inscripcion.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('rechazar_inscripcion_' ~ inscripcion.id) }}">
                            <button type="submit" class="btn btn-outline-danger">Rechazar</button>
                        </form>
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>
{% endif %}

{% if suscripcionProfesor and suscripcionProfesor.tipoSolicitud == 'alta' and suscripcionProfesor.estado != 'activa' %}
    <section class="profesor__bloque mb-4">
        <h2>Completa tu alta docente</h2>

        <form method="post" class="profesor__formulario">
            <input type="hidden" name="formulario" value="elegir_plan">
            <input type="hidden" name="_token" value="{{ csrf_token('elegir_plan') }}">

            <div class="row g-4">
                <div class="col-12 col-lg-6">
                    <label for="plan_docente" class="form-label">Plan</label>
                    <select id="plan_docente" name="plan" class="form-select" required>
                        <option value="basico" {{ (suscripcionProfesor.planSolicitado ?: suscripcionProfesor.plan) == 'basico' ? 'selected' : '' }}>Básico · 1 curso</option>
                        <option value="pro" {{ (suscripcionProfesor.planSolicitado ?: suscripcionProfesor.plan) == 'pro' ? 'selected' : '' }}>Pro · 5 cursos</option>
                        <option value="premium" {{ (suscripcionProfesor.planSolicitado ?: suscripcionProfesor.plan) == 'premium' ? 'selected' : '' }}>Premium · ilimitados</option>
                    </select>
                </div>

                <div class="col-12 col-lg-6">
                    <label class="form-label">Cuenta bancaria para el pago</label>
                    <div class="form-control d-flex align-items-center">{{ cuentaBancariaDocente }}</div>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="confirmacion_pago_alta" name="confirmacion_pago" value="1" required>
                        <label class="form-check-label" for="confirmacion_pago_alta">
                            Confirmo que he revisado la cuenta bancaria y he realizado el pago del plan docente.
                        </label>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary mt-4">
                Confirmar pago y enviar al administrador
            </button>
        </form>
    </section>
{% endif %}

<section class="profesor__bloque mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="mb-1">Crear curso</h2>
            <p class="mb-0">Puedes mantener el formulario plegado y abrirlo solo cuando lo necesites.</p>
        </div>
        {% if not puedeCrearCursos %}
            <span class="badge text-bg-danger">Bloqueado</span>
        {% endif %}
    </div>

    {% if puedeCrearCursos %}
        <details class="w-100" {% if datosCurso.titulo or datosCurso.descripcion %}open{% endif %}>
            <summary class="btn btn-primary mb-4">Nuevo curso</summary>

            <form method="post" class="profesor__formulario">
                <input type="hidden" name="formulario" value="crear_curso">
                <input type="hidden" name="_token" value="{{ csrf_token('crear_curso') }}">

                <div class="row g-4">
                    <div class="col-12 col-lg-6">
                        <label for="titulo_curso" class="form-label">Título del curso</label>
                        <input
                            type="text"
                            id="titulo_curso"
                            name="titulo_curso"
                            class="form-control"
                            placeholder="{{ 'profesor.crear_curso.placeholder_titulo'|trans }}"
                            value="{{ datosCurso.titulo|default('') }}"
                            required
                        >
                    </div>

                    <div class="col-12 col-lg-6">
                        <label for="duracion_curso" class="form-label">Duración</label>
                        <input
                            type="text"
                            id="duracion_curso"
                            name="duracion_curso"
                            class="form-control"
                            placeholder="{{ 'profesor.crear_curso.placeholder_duracion'|trans }}"
                            value="{{ datosCurso.duracion|default('') }}"
                            required
                        >
                    </div>

                    <div class="col-12">
                        <label for="descripcion_curso" class="form-label">Descripción</label>
                        <textarea
                            id="descripcion_curso"
                            name="descripcion_curso"
                            class="form-control"
                            rows="5"
                            placeholder="{{ 'profesor.crear_curso.placeholder_descripcion'|trans }}"
                            required
                        >{{ datosCurso.descripcion|default('') }}</textarea>
                    </div>

                    <div class="col-12 col-lg-4">
                        <label for="nivel_curso" class="form-label">Nivel</label>
                        <select id="nivel_curso" name="nivel_curso" class="form-select" required>
                            <option value="" {{ datosCurso.nivel|default('') == '' ? 'selected' : '' }} disabled>{{ 'profesor.crear_curso.selecciona_opcion'|trans }}</option>
                            <option value="Inicial" {{ datosCurso.nivel|default('') == 'Inicial' ? 'selected' : '' }}>Inicial</option>
                            <option value="Intermedio" {{ datosCurso.nivel|default('') == 'Intermedio' ? 'selected' : '' }}>Intermedio</option>
                            <option value="Avanzado" {{ datosCurso.nivel|default('') == 'Avanzado' ? 'selected' : '' }}>Avanzado</option>
                        </select>
                    </div>

                    <div class="col-12 col-lg-4">
                        <label for="modalidad_curso" class="form-label">Modalidad</label>
                        <select id="modalidad_curso" name="modalidad_curso" class="form-select" required>
                            <option value="" {{ datosCurso.modalidad|default('') == '' ? 'selected' : '' }} disabled>{{ 'profesor.crear_curso.selecciona_opcion'|trans }}</option>
                            <option value="Online" {{ datosCurso.modalidad|default('') == 'Online' ? 'selected' : '' }}>Online</option>
                            <option value="Presencial" {{ datosCurso.modalidad|default('') == 'Presencial' ? 'selected' : '' }}>Presencial</option>
                            <option value="Mixto" {{ datosCurso.modalidad|default('') == 'Mixto' ? 'selected' : '' }}>Mixto</option>
                        </select>
                    </div>

                    <div class="col-12 col-lg-4">
                        <label for="precio_curso" class="form-label">Precio (€)</label>
                        <input
                            type="number"
                            step="0.01"
                            min="0"
                            id="precio_curso"
                            name="precio_curso"
                            class="form-control"
                            placeholder="49.99"
                            value="{{ datosCurso.precio|default('') }}"
                            required
                        >
                    </div>

                    <div class="col-12 col-lg-6">
                        <label for="banner_url" class="form-label">URL del banner</label>
                        <input
                            type="url"
                            id="banner_url"
                            name="banner_url"
                            class="form-control"
                            placeholder="{{ 'profesor.crear_curso.placeholder_banner'|trans }}"
                            value="{{ datosCurso.banner_url|default('') }}"
                        >
                    </div>

                    <div class="col-12 col-lg-6">
                        <label for="mapa_url" class="form-label">URL de mapa o ubicación</label>
                        <input
                            type="url"
                            id="mapa_url"
                            name="mapa_url"
                            class="form-control"
                            placeholder="{{ 'profesor.crear_curso.placeholder_mapa'|trans }}"
                            value="{{ datosCurso.mapa_url|default('') }}"
                        >
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        Guardar curso
                    </button>
                </div>
            </form>
        </details>
    {% else %}
        <div class="estado-vacio">
            <div class="estado-vacio__icono">!</div>
            <h3 class="estado-vacio__titulo">Creación de cursos bloqueada</h3>
            <p class="estado-vacio__texto">
                {{ mensajeSuscripcion ?: 'Ahora mismo no puedes crear cursos.' }}
            </p>
        </div>
    {% endif %}
</section>

<section class="profesor__bloque profesor__bloque--ancho">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="mb-1">Mis cursos creados</h2>
            <p class="mb-0">Cada curso incluye accesos rápidos, alumnos y progreso.</p>
        </div>
        <span class="badge text-bg-primary">{{ cursosProfesor|length }} curso(s)</span>
    </div>

    {% if cursosProfesor is empty %}
        <div class="estado-vacio">
            <div class="estado-vacio__icono">0</div>
            <h3 class="estado-vacio__titulo">Todavía no has creado cursos</h3>
            <p class="estado-vacio__texto">
                Cuando crees tu primer curso aparecerá aquí con su información principal.
            </p>
        </div>
    {% else %}
        <div class="d-flex flex-column gap-4">
            {% for curso in cursosProfesor %}
                {% set alumnos = alumnosPorCurso[curso.id]|default([]) %}

                <article class="curso-usuario">
                    <div class="curso-usuario__superior">
                        <span class="badge text-bg-primary">{{ curso.nivel }}</span>
                        <span class="curso-usuario__progreso">{{ curso.modalidad }} · {{ curso.estado|capitalize }}</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div>
                            <h3>{{ curso.titulo }}</h3>
                            <p>{{ curso.descripcion|length > 150 ? curso.descripcion|slice(0, 150) ~ '...' : curso.descripcion }}</p>
                        </div>

                        <div class="curso-usuario__meta">
                            <span>Duración: {{ curso.duracion }}</span>
                            <span>Precio: {{ curso.precio }} €</span>
                        </div>
                    </div>

                    <div class="curso-usuario__acciones mb-4">
                        <a href="{{ path('app_detalle_curso', {id: curso.id}) }}" class="btn btn-outline-secondary">Vista pública</a>
                        <a href="{{ path('app_profesor_editar_curso', {id: curso.id}) }}" class="btn btn-outline-secondary">Editar curso</a>
                        <a href="{{ path('app_profesor_recursos_curso', {id: curso.id}) }}" class="btn btn-outline-secondary">Recursos</a>
                        <a href="{{ path('app_profesor_tareas_curso', {id: curso.id}) }}" class="btn btn-outline-secondary">Tareas y correcciones</a>

                        <form method="post" action="{{ path('app_profesor_eliminar_curso', {id: curso.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('eliminar_curso_' ~ curso.id) }}">
                            <button type="submit" class="btn btn-outline-danger">Eliminar</button>
                        </form>
                    </div>

                    <details class="w-100">
                        <summary class="btn btn-primary">Ver alumnos y progreso</summary>

                        <div class="mt-4">
                            {% if alumnos is empty %}
                                <div class="estado-vacio">
                                    <div class="estado-vacio__icono">0</div>
                                    <h3 class="estado-vacio__titulo">Sin alumnos activos</h3>
                                    <p class="estado-vacio__texto">Cuando haya inscripciones activas aparecerán aquí.</p>
                                </div>
                            {% else %}
                                <div class="table-responsive">
                                    <table class="table profesor__tabla-entregas align-middle">
                                        <thead>
                                            <tr>
                                                <th>Alumno</th>
                                                <th>Correo</th>
                                                <th>Progreso</th>
                                                <th>Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for inscripcion in alumnos %}
                                                <tr>
                                                    <td>{{ inscripcion.estudiante.nombre }}</td>
                                                    <td>{{ inscripcion.estudiante.email }}</td>
                                                    <td>{{ inscripcion.progreso }}%</td>
                                                    <td>{{ inscripcion.estado|capitalize }}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% endif %}
                        </div>
                    </details>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</section>