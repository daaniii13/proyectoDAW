<div class="profesor__cabecera">
    <div>
        <span class="profesor__etiqueta">{{ 'Panel docente'|traducir_dinamico }}</span>
        <h1>{{ 'Gestión del curso'|traducir_dinamico }}</h1>
        <p class="profesor__texto">
            {{ 'Organiza tu plan, revisa solicitudes, crea cursos y controla alumnos desde un único panel.'|traducir_dinamico }}
        </p>
    </div>
</div>

{#Mensajes de exito o error despues de una accion#}
{% for mensaje in app.flashes('success') %}
    <div class="mensaje-ui mensaje-ui--exito profesor__nota">
        <span>{{ mensaje|traducir_dinamico }}</span>
    </div>
{% endfor %}

{% for mensaje in app.flashes('error') %}
    <div class="mensaje-ui mensaje-ui--error profesor__nota">
        <span>{{ mensaje|traducir_dinamico }}</span>
    </div>
{% endfor %}

{#Error especifico del curso#}
{% if errorCurso %}
    <div class="mensaje-ui mensaje-ui--error profesor__nota">
        <span>{{ errorCurso|traducir_dinamico }}</span>
    </div>
{% endif %}