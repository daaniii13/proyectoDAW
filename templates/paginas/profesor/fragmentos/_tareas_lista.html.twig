<section class="profesor__bloque profesor__bloque--ancho">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">Tareas y entregas</h2>
            <p class="mb-0">Cada tarea muestra sus entregas y el formulario de corrección.</p>
        </div>

        <a href="{{ path('app_subir_recursos') }}" class="btn btn-outline-secondary">
            Volver al panel docente
        </a>
    </div>

    {% if tareas is empty %}
        <div class="estado-vacio">
            <div class="estado-vacio__icono">0</div>
            <h3 class="estado-vacio__titulo">Todavía no hay tareas</h3>
            <p class="estado-vacio__texto">
                Crea la primera tarea para este curso.
            </p>
        </div>
    {% else %}
        <div class="d-flex flex-column gap-4">
            {% for tarea in tareas %}
                {% set entregasTarea = entregasPorTarea[tarea.id]|default([]) %}

                <article class="curso-usuario">
                    <div class="curso-usuario__superior">
                        <span class="badge text-bg-primary">Tarea</span>
                        <span class="curso-usuario__progreso">
                            {{ entregasTarea|length }} entrega(s)
                        </span>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                        <div class="flex-grow-1">
                            <h3>{{ tarea.titulo }}</h3>
                            <p>{{ tarea.descripcion }}</p>

                            <div class="curso-usuario__meta">
                                <span>Creada: {{ tarea.fechaCreacion|date('d/m/Y H:i') }}</span>
                                <span>
                                    Límite:
                                    {{ tarea.fechaLimite ? tarea.fechaLimite|date('d/m/Y H:i') : 'Sin fecha límite' }}
                                </span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            {% if tarea.archivoProfesor %}
                                <a href="{{ asset('uploads/tareas/' ~ tarea.archivoProfesor) }}" target="_blank" class="btn btn-outline-secondary">
                                    Ver archivo de la tarea
                                </a>
                            {% endif %}
                        </div>
                    </div>

                    <details class="mt-4">
                        <summary class="btn btn-outline-secondary">Editar tarea</summary>

                        <form method="post" enctype="multipart/form-data" action="{{ path('app_profesor_editar_tarea', {id: tarea.id}) }}" class="profesor__formulario mt-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('editar_tarea_' ~ tarea.id) }}">

                            <div class="mb-3">
                                <label class="form-label">Título</label>
                                <input type="text" name="titulo_tarea" class="form-control" value="{{ tarea.titulo }}" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Descripción</label>
                                <textarea name="descripcion_tarea" class="form-control" rows="4" required>{{ tarea.descripcion }}</textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Fecha límite</label>
                                <input
                                    type="datetime-local"
                                    name="fecha_limite_tarea"
                                    class="form-control"
                                    value="{{ tarea.fechaLimite ? tarea.fechaLimite|date('Y-m-d\\TH:i') : '' }}"
                                >
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Sustituir archivo adjunto</label>
                                <input type="file" name="archivo_profesor" class="form-control">
                            </div>

                            <button type="submit" class="btn btn-primary">
                                Guardar cambios
                            </button>
                        </form>
                    </details>

                    <form method="post" action="{{ path('app_profesor_eliminar_tarea', {id: tarea.id}) }}" onsubmit="return confirm('¿Seguro que quieres eliminar esta tarea?');" class="mt-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('eliminar_tarea_' ~ tarea.id) }}">
                        <button type="submit" class="btn btn-outline-danger">
                            Eliminar tarea
                        </button>
                    </form>

                    {% if entregasTarea is empty %}
                        <div class="estado-vacio mt-3">
                            <div class="estado-vacio__icono">0</div>
                            <h3 class="estado-vacio__titulo">Sin entregas todavía</h3>
                            <p class="estado-vacio__texto">Cuando los alumnos entreguen, aparecerán aquí.</p>
                        </div>
                    {% else %}
                        <div class="table-responsive mt-3">
                            <table class="table profesor__tabla-entregas align-middle">
                                <thead>
                                    <tr>
                                        <th>Alumno</th>
                                        <th>Fecha</th>
                                        <th>Estado</th>
                                        <th>Nota</th>
                                        <th>Archivo</th>
                                        <th>Corrección</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for entrega in entregasTarea %}
                                        <tr>
                                            <td>
                                                <strong>{{ entrega.estudiante.nombre }}</strong><br>
                                                <small>{{ entrega.estudiante.email }}</small>
                                            </td>
                                            <td>{{ entrega.fechaEntrega|date('d/m/Y H:i') }}</td>
                                            <td>
                                                {% if entrega.estadoRevision == 'aprobada' %}
                                                    <span class="badge text-bg-success">Aprobada</span>
                                                {% elseif entrega.estadoRevision == 'suspensa' %}
                                                    <span class="badge text-bg-danger">Suspensa</span>
                                                {% else %}
                                                    <span class="badge text-bg-warning">Pendiente</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ entrega.nota is not null ? entrega.nota : '-' }}</td>
                                            <td>
                                                {% if entrega.archivoEntrega %}
                                                    <a href="{{ path('app_profesor_ver_entrega', {id: entrega.id}) }}" target="_blank" class="btn btn-sm btn-outline-secondary">
                                                        Ver entrega
                                                    </a>
                                                {% else %}
                                                    -
                                                {% endif %}
                                            </td>
                                            <td style="min-width: 340px;">
                                                <form method="post" action="{{ path('app_profesor_corregir_entrega', {id: entrega.id}) }}" class="d-flex flex-column gap-2">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('corregir_entrega_' ~ entrega.id) }}">

                                                    <div>
                                                        <label class="form-label">Nota (0-100)</label>
                                                        <input
                                                            type="number"
                                                            name="nota"
                                                            min="0"
                                                            max="100"
                                                            class="form-control"
                                                            value="{{ entrega.nota is not null ? entrega.nota : '' }}"
                                                            required
                                                        >
                                                    </div>

                                                    <div>
                                                        <label class="form-label">Comentario del profesor</label>
                                                        <textarea
                                                            name="comentario_profesor"
                                                            rows="3"
                                                            class="form-control"
                                                            placeholder="{{ 'profesor.tareas.placeholder_comentario_opcional'|trans }}"
                                                        >{{ entrega.comentarioProfesor ?: '' }}</textarea>
                                                    </div>

                                                    <button type="submit" class="btn btn-primary">
                                                        Guardar corrección
                                                    </button>
                                                </form>

                                                {% if entrega.comentario %}
                                                    <div class="mt-3">
                                                        <strong>Comentario del alumno:</strong>
                                                        <p class="mb-0">{{ entrega.comentario }}</p>
                                                    </div>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    {% endif %}
</section>