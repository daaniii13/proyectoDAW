{% extends 'base.html.twig' %}

{% block title %}{{ 'profesor.recursos_curso.meta_titulo'|trans }}{% endblock %}

{% block body %}
<div data-dynamic-translate="1">
<section class="seccion-profesor">
    <div class="container">
        <div class="profesor__cabecera">
            <div>
                <span class="profesor__etiqueta">Recursos</span>
                <h1>{{ curso.titulo }}</h1>
                <p class="profesor__texto">
                    Añade contenido teórico, enlaces y archivos descargables para tus alumnos.
                </p>
            </div>
        </div>

        {#Notificaciones flash para mensajes de exito y error#}
        {% for mensaje in app.flashes('success') %}
            <div class="mensaje-ui mensaje-ui--exito profesor__nota">
                <span>{{ mensaje }}</span>
            </div>
        {% endfor %}

        {% for mensaje in app.flashes('error') %}
            <div class="mensaje-ui mensaje-ui--error profesor__nota">
                <span>{{ mensaje }}</span>
            </div>
        {% endfor %}

        {#Error especifico de recursos#}
        {% if errorRecurso %}
            <div class="mensaje-ui mensaje-ui--error profesor__nota">
                <span>{{ errorRecurso }}</span>
            </div>
        {% endif %}

        <div class="profesor__grid">

            {#Apartado de crear recurso#}
            <section class="profesor__bloque">
                <h2>Crear recurso</h2>

                <form method="post" enctype="multipart/form-data" class="profesor__formulario">
                    <input type="hidden" name="formulario" value="crear_recurso">
                    <input type="hidden" name="_token" value="{{ csrf_token('crear_recurso_' ~ curso.id) }}">

                    {#Titulo del recurso#}
                    <div class="mb-3">
                        <label for="titulo_recurso" class="form-label">Título</label>
                        <input type="text" id="titulo_recurso" name="titulo_recurso" class="form-control" value="{{ datosRecurso.titulo|default('') }}" required>
                    </div>

                    {#Tipo de recurso#}
                    <div class="mb-3">
                        <label for="tipo_recurso" class="form-label">Tipo</label>
                        <select id="tipo_recurso" name="tipo_recurso" class="form-select" required>
                            <option value="" disabled {{ datosRecurso.tipo|default('') == '' ? 'selected' : '' }}>Selecciona un tipo</option>
                            <option value="texto" {{ datosRecurso.tipo|default('') == 'texto' ? 'selected' : '' }}>Texto</option>
                            <option value="documento" {{ datosRecurso.tipo|default('') == 'documento' ? 'selected' : '' }}>Documento</option>
                            <option value="enlace" {{ datosRecurso.tipo|default('') == 'enlace' ? 'selected' : '' }}>Enlace</option>
                            <option value="video" {{ datosRecurso.tipo|default('') == 'video' ? 'selected' : '' }}>Vídeo</option>
                        </select>
                    </div>

                    {#Descripcion#}
                    <div class="mb-3">
                        <label for="contenido_recurso" class="form-label">Contenido o descripción</label>
                        <textarea id="contenido_recurso" name="contenido_recurso" class="form-control" rows="5" required>{{ datosRecurso.contenido|default('') }}</textarea>
                    </div>

                    {#Orden de los recursos#}
                    <div class="mb-3">
                        <label for="orden_recurso" class="form-label">Orden</label>
                        <input type="number" min="1" id="orden_recurso" name="orden_recurso" class="form-control" value="{{ datosRecurso.orden|default('') }}" required>
                    </div>

                    {#Subir archivo#}
                    <div class="mb-3">
                        <label for="archivo_recurso" class="form-label">Archivo adjunto</label>
                        <input type="file" id="archivo_recurso" name="archivo_recurso" class="form-control">
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Guardar recurso
                    </button>
                </form>
            </section>

            {#Listado de recursos#}
            <section class="profesor__bloque profesor__bloque--ancho">
                <h2>Recursos creados</h2>

                {% if recursos is empty %}
                    <div class="estado-vacio">
                        <div class="estado-vacio__icono">0</div>
                        <h3 class="estado-vacio__titulo">Todavía no has creado recursos</h3>
                        <p class="estado-vacio__texto">Cuando añadas recursos aparecerán aquí.</p>
                    </div>
                {% else %}
                    <div class="d-flex flex-column gap-4">
                        {% for recurso in recursos %}
                            {#Apartado del recurso existente#}
                            <article class="curso-usuario">
                                {#Orden y tipo#}
                                <div class="curso-usuario__superior">
                                    <span class="badge text-bg-primary">#{{ recurso.orden }}</span>
                                    <span class="curso-usuario__progreso">{{ recurso.tipo|capitalize }}</span>
                                </div>

                                <h3>{{ recurso.titulo }}</h3>
                                <p>{{ recurso.contenido }}</p>

                                {#Condicional si tiene archivo#}
                                <div class="curso-usuario__meta">
                                    {% if recurso.archivoUrl %}
                                        <span>Archivo adjunto disponible</span>
                                    {% else %}
                                        <span>Sin archivo adjunto</span>
                                    {% endif %}
                                </div>

                                {#Ver archivo#}
                                <div class="curso-usuario__acciones">
                                    {% if recurso.archivoUrl %}
                                        <a href="{{ asset('uploads/recursos/' ~ recurso.archivoUrl) }}" target="_blank" class="btn btn-outline-secondary">
                                            Ver archivo
                                        </a>
                                    {% endif %}
                                </div>

                                {#Editar#}
                                <details class="mt-4">
                                    <summary class="btn btn-outline-secondary">Editar recurso</summary>

                                    {#Formulario de edicion del recurso#}
                                    <form method="post" enctype="multipart/form-data" action="{{ path('app_profesor_editar_recurso', {id: recurso.id}) }}" class="profesor__formulario mt-3">
                                        <input type="hidden" name="_token" value="{{ csrf_token('editar_recurso_' ~ recurso.id) }}">

                                        <div class="mb-3">
                                            <label class="form-label">Título</label>
                                            <input type="text" name="titulo_recurso" class="form-control" value="{{ recurso.titulo }}" required>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Tipo</label>
                                            <select name="tipo_recurso" class="form-select" required>
                                                <option value="texto" {{ recurso.tipo == 'texto' ? 'selected' : '' }}>Texto</option>
                                                <option value="documento" {{ recurso.tipo == 'documento' ? 'selected' : '' }}>Documento</option>
                                                <option value="enlace" {{ recurso.tipo == 'enlace' ? 'selected' : '' }}>Enlace</option>
                                                <option value="video" {{ recurso.tipo == 'video' ? 'selected' : '' }}>Vídeo</option>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Contenido o descripción</label>
                                            <textarea name="contenido_recurso" class="form-control" rows="4" required>{{ recurso.contenido }}</textarea>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Orden</label>
                                            <input type="number" min="1" name="orden_recurso" class="form-control" value="{{ recurso.orden }}" required>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Sustituir archivo adjunto</label>
                                            <input type="file" name="archivo_recurso" class="form-control">
                                        </div>

                                        <button type="submit" class="btn btn-primary">
                                            Guardar cambios
                                        </button>
                                    </form>
                                </details>

                                {#Eliminar recurso#}
                                <form method="post" action="{{ path('app_profesor_eliminar_recurso', {id: recurso.id}) }}" onsubmit="return confirm('¿Seguro que quieres eliminar este recurso?');" class="mt-3">
                                    <input type="hidden" name="_token" value="{{ csrf_token('eliminar_recurso_' ~ recurso.id) }}">
                                    <button type="submit" class="btn btn-outline-danger">
                                        Eliminar recurso
                                    </button>
                                </form>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        </div>
    </div>
</section>
</div>
{% endblock %}